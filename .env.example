# === opencrab 的大脑(model-agnostic)===
# 任何 OpenAI 兼容端点：OpenAI / DeepSeek / Kimi / OpenRouter / 本地 vLLM ...
OPENCRAB_API_KEY=
OPENCRAB_BASE_URL=https://api.openai.com/v1
OPENCRAB_MODEL=gpt-4o-mini

# === 生命节律 ===
OPENCRAB_TICK_SECONDS=3600      # 多久心跳一次(秒)
OPENCRAB_DAILY_ENERGY=50000     # 每日体力(token 预算)，花完就歇

# === 蜕壳(持续学习)===
OPENCRAB_MOLT_EVERY=24          # 每多少次心跳蜕一次壳：蒸馏 skill + 压缩记忆

# === 它的手(自我进化的工具)===
# journal = 只写日志(默认) | propose = 自己开分支、真动手改代码让自己进化
OPENCRAB_AUTONOMY=journal
OPENCRAB_EXECUTOR=claude         # claude(已验证) | codex(实验性)
OPENCRAB_HAND_BUDGET_USD=0.5     # 每次动手的美元上限(呼应体力)
